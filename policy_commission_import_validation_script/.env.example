# PieQ Policy Commission Data Import Configuration
# ------------------------------------------------
# API Base URL (e.g. https://prod.api.pieq.ai or https://preprod.api.pieq.ai)
API_BASE_URL=https://prod.api.pieq.ai

# Optional Authorization Bearer Token (if already authenticated)
# AUTH_TOKEN=your_jwt_bearer_token_here

# Upload File Path(s)
# Supports a single file path, directory path (scans all files), or comma-separated file paths:
#   Single File: UPLOAD_FILE_PATH=/path/to/your/sample_policy_commission_import.xlsx
#   Directory:   UPLOAD_FILE_PATH=/path/to/your/imports_directory
#   Multiple:    UPLOAD_FILE_PATH=/path/to/file1.xlsx,/path/to/file2.xlsx
UPLOAD_FILE_PATH=/path/to/your/sample_policy_commission_import.xlsx

# Parallel Worker Batch Size (Default: 5)
BATCH_SIZE=5

# Auto-Confirm All Payloads Without Prompting (1=Auto Confirm, 0=Interactive prompt)
AUTO_CONFIRM=0

# Required Client Identity Headers
X_CLIENT_ID=pieq
X_SERVICE_NAME=pieq

# Keycloak SSO Auto-Authentication & Token Refresh Settings
AUTH_URL=https://prod.auth.pieq.ai
KEYCLOAK_CLIENT_ID=pieq-app
USERNAME=user@example.com
PASSWORD=your_sso_password
