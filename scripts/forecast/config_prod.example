# Production forecast config. Loaded with:
#   py review_to_reconcile_file_forecast.py prod <commission_statement_uuid>
# The script only SELECTs from the database and never POSTs or PUTs to the API base URL.
#
# Copy to config_prod and fill in local values. config_prod is gitignored.

PIEQ_API_BASE_URL=https://prod.api.pieq.ai

# Keycloak SSO password grant. The token is requested at
# {AUTH_URL}/realms/pieq-sso/protocol/openid-connect/token
AUTH_URL=https://prod.auth.pieq.ai
client_id=pieq-app
USERNAME=
PASSWORD=
grant_type=password

# Source database. Read only. Username and password are separate from the host.
PIEQ_DB_HOST=
PIEQ_DB_PORT=5432
PIEQ_DB_NAME=
PIEQ_DB_USERNAME=
PIEQ_DB_PASSWORD=

# Carrier statement used to cross-check commission_detail_report.csv.
# Use one file, or a folder whose file names match commission statement names.
APL_STATEMENT_PATH=
# APL_STATEMENT_DIR=/path/to/carrier_statements
# APL drives by default. Set to icm to reverse and drive from forecast payables.
APL_VALIDATION_MODE=icm
