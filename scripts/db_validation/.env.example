# ===================================================================
# APL & ICM Commission Database Validation Engine Configuration (.env)
# ===================================================================

# -------------------------------------------------------------------
# 1. READ-ONLY POSTGRESQL DATABASE CREDENTIALS
# -------------------------------------------------------------------
# Target database connection string (URL format: postgresql://host:port/dbname)
DATABASE_URL=postgresql://localhost:5432/pieq_db

# Read-Only Database User & Password
DB_USER=readonly_user
DB_PASSWORD=readonly_password

# Target Agency ID (Default: 5)
AGENCY_ID=5

# -------------------------------------------------------------------
# 2. INPUT FILE & DIRECTORY CONFIGURATION
# -------------------------------------------------------------------
# Path to input APL Policy Commission upload file (CSV or XLSX) or folder of files
UPLOAD_FILE_PATH=sample_policy_commission_import.xlsx

# -------------------------------------------------------------------
# 3. OPTIONAL MASTER RATE SHEET & NORMALIZATION MAP
# -------------------------------------------------------------------
# Master Rate Sheet for Carrier Commission benchmarking (Optional)
RATE_SHEET_PATH=ProductWise Commission Rate.xlsx

# External Product Name Normalization Mapping File (Optional)
NORM_FILE_PATH=Final Product Normalization Local.xlsx

# Optional Master Agent Roster File Path (Agent Name -> Agent ID)
AGENT_ROSTER_PATH=Agent ID, Agent Name Roaster Final.xlsx
